pkgname=hiddify-tui
pkgver=@VERSION@
pkgrel=1
pkgdesc='Terminal client for hiddify-core'
arch=('x86_64' 'aarch64')
url='https://github.com/1suo/hiddify-tui'
license=('MIT')
depends=('glibc')
optdepends=('wl-clipboard: Wayland clipboard support' 'xclip: X11 clipboard support' 'xsel: alternative X11 clipboard support')
source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/hiddify-tui_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/hiddify-tui_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=('@SHA_LINUX_AMD64@')
sha256sums_aarch64=('@SHA_LINUX_ARM64@')

package() {
  install -Dm755 hiddify-tui "$pkgdir/usr/bin/hiddify-tui"
  install -Dm755 hiddify-migrate "$pkgdir/usr/bin/hiddify-migrate"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 docs/man/hiddify-tui.1 "$pkgdir/usr/share/man/man1/hiddify-tui.1"
  install -Dm644 completions/hiddify-tui.bash "$pkgdir/usr/share/bash-completion/completions/hiddify-tui"
  install -Dm644 completions/_hiddify-tui "$pkgdir/usr/share/zsh/site-functions/_hiddify-tui"
  install -Dm644 completions/hiddify-tui.fish "$pkgdir/usr/share/fish/vendor_completions.d/hiddify-tui.fish"
}
