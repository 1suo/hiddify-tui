[Unit]
Description=Hiddify Core local control daemon (user session)
Documentation=https://github.com/1suo/hiddify-tui
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/hiddify-core daemon run --state-dir=%h/.local/state/hiddify --socket=%t/hiddify/control.sock
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s
RuntimeDirectory=hiddify
RuntimeDirectoryMode=0700

[Install]
WantedBy=default.target
