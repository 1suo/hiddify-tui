[Unit]
Description=Hiddify Core headless service
Documentation=https://github.com/1suo/hiddify-tui
Wants=network-online.target
After=network-online.target
ConditionPathIsExecutable=/usr/lib/hiddify/hiddify-core

[Service]
Type=simple
ExecStart=/usr/lib/hiddify/hiddify-core run -c /etc/hiddify/active-config.json
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s
UMask=0077
PrivateTmp=true
ProtectSystem=full
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
