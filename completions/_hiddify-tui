#compdef hiddify-tui

_hiddify-tui() {
  local -a commands
  commands=(
    'status:show core status'
    'connect:connect a profile'
    'disconnect:disconnect the active profile'
    'restart:restart with the active profile'
    'profile:manage profiles'
    'outbound:manage outbounds'
    'logs:follow core logs'
    'settings:validate or apply settings'
    'migrate:import GUI data'
    'install-core:install the standalone core'
  )
  _arguments -C \
    '--address[core gRPC address]:address' \
    '--profile-file[profile store]:file:_files' \
    '--core-binary[standalone core binary]:file:_files' \
    '--timeout[startup or request timeout]:duration' \
    '--json[produce JSON output]' \
    '--no-color[disable terminal color]' \
    '--version[print version]' \
    '1:command:->command' \
    '*::argument:->args'
  case $state in
    command) _describe command commands ;;
    args)
      case $words[2] in
        profile) _values action list show add add-file add-stdin rename activate refresh delete ;;
        outbound) _values action list select test ;;
        settings) _values action set validate ;;
        migrate) _values source gui ;;
      esac
      ;;
  esac
}

_hiddify-tui "$@"
